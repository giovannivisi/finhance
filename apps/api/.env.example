# Local development example — copy to apps/api/.env and adjust.
# Every value below is a placeholder; never commit real secrets.

# PostgreSQL connection string.
# Local Docker instance matching CI credentials:
#   docker run -d --name finhance-pg -e POSTGRES_DB=finhance \
#     -e POSTGRES_PASSWORD=prisma -e POSTGRES_USER=prisma -p 5432:5432 postgres:16
DATABASE_URL="postgresql://prisma:prisma@localhost:5432/finhance?sslmode=disable"

# Local single-user mode (loopback only). Hosted deployments use AUTH_MODE=hosted.
AUTH_MODE=local

# API port. Defaults to 3000.
# PORT=3000

# --- Optional cloud transaction parsing (Groq) ---
# Leave GROQ_API_KEY unset to keep the cloud parser unavailable; the built-in
# heuristic parser remains available. Never expose this key to web or mobile
# clients, and do not use an EXPO_PUBLIC_ variable for it.
# GROQ_API_KEY=
# AI_MODEL=openai/gpt-oss-20b
# AI_RATE_LIMIT_PER_MINUTE=3
# AI_DAILY_LIMIT_PER_USER=10
# AI_DAILY_LIMIT_GLOBAL=100
# AI_DISABLED=false

# --- Optional global listed-security market data ---
# Yahoo remains the no-key local fallback. For exact exchange-listed stock and
# bond prices across the full app catalogue, create server-side EODHD and
# Marketstack credentials and enable the hybrid router. Never expose either
# credential to web or mobile clients.
# MARKET_DATA_PROVIDER=hybrid
# EODHD_API_TOKEN=
# MARKETSTACK_API_KEY=
# Maximum combined outbound requests per provider each minute, across all users.
# MARKET_DATA_REQUEST_LIMIT_PER_MINUTE=10

# --- Hosted-only settings (Render deployment) — not needed for local dev ---
# API_HOST=api.example.com
# API_ALLOWED_ORIGINS=https://app.example.com
# API_TRUST_PROXY=1
# AUTH_API_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# AUTH_API_JWT_ISSUER=finhance-web
# AUTH_API_JWT_AUDIENCE=finhance-api
# AUTH_API_JWT_KID=finhance-es256
