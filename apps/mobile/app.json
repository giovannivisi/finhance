{
  "expo": {
    "name": "finhance",
    "slug": "finhance",
    "version": "0.1.0",
    "scheme": "finhance",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.finhance.mobile",
      "associatedDomains": ["webcredentials:finhance-web.vercel.app"],
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png"
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "app.finhance.mobile",
      "edgeToEdgeEnabled": true,
      "usesCleartextTraffic": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#050505"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-light.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#f4f4f5",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#050505"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow finhance to use Face ID to unlock the app."
        }
      ],
      "./plugins/with-minimum-ios-pod-target"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
