    "@finhance/shared": "workspace:^",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.17.2",
    "@tanstack/react-query": "^5.90.2",
    "expo": "~54.0.0",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~56.0.4",
    "expo-font": "~14.0.12",
