# Local development example — copy to apps/web/.env.local and adjust.
# Every value below is a placeholder; never commit real secrets.

# Where the browser reaches the API in local development.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3000

# Local single-user mode (loopback only). Hosted deployments use AUTH_MODE=hosted.
AUTH_MODE=local

# Optional: override the base URL used by server-side page fetches.
# Defaults to loopback in local development.
# API_INTERNAL_URL=http://127.0.0.1:3000

# --- Hosted-only settings (Vercel deployment) — not needed for local dev ---
# AUTH_SECRET=generate-with: openssl rand -base64 32
# AUTH_GOOGLE_ID=...
# AUTH_GOOGLE_SECRET=...
# AUTH_GITHUB_ID=...
# AUTH_GITHUB_SECRET=...
# AUTH_SIGNUP_MODE=bootstrap
# AUTH_BOOTSTRAP_EMAIL=you@example.com
# AUTH_API_JWT_PRIVATE_KEY=paste-the-es256-private-key-pem-here
# AUTH_API_JWT_ISSUER=finhance-web
# AUTH_API_JWT_AUDIENCE=finhance-api
# AUTH_API_JWT_KID=finhance-es256
# AUTH_MOBILE_TOKEN_TTL=120d
# AUTH_MOBILE_ALLOW_DEV_REDIRECTS=true
# AUTH_WEBAUTHN_RP_ID=example.com
# AUTH_WEBAUTHN_ORIGIN=https://example.com
