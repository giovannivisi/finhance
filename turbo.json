{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": [
        "AUTH_MODE",
        "DATABASE_URL",
        "AUTH_URL",
        "AUTH_SECRET",
        "AUTH_BOOTSTRAP_EMAIL",
        "AUTH_GOOGLE_ID",
        "AUTH_GOOGLE_SECRET",
        "AUTH_GITHUB_ID",
        "AUTH_GITHUB_SECRET",
        "MARKET_DATA_PROVIDER",
        "AUTH_API_JWT_ISSUER",
        "AUTH_API_JWT_AUDIENCE",
        "AUTH_API_JWT_KID",
        "AUTH_API_JWT_PRIVATE_KEY",
        "NEXT_PUBLIC_API_URL"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
