{
  "name": "@finhance/db",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "main": "./index.cjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.cjs"
    }
  },
  "scripts": {
    "build": "prisma generate --schema prisma/schema.prisma",
    "check-types": "tsc --noEmit",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "prisma:db:push": "prisma db push --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:reset": "prisma migrate reset --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "prisma": "^6.19.0",
    "typescript": "5.9.2"
  },
  "license": "MIT",
  "author": "giovisi"
}
