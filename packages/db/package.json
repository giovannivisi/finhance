{
  "name": "@finhance/db",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "main": "./index.cjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs",
      "default": "./index.cjs"
    }
  },
  "scripts": {
    "build": "prisma generate --schema prisma/schema.prisma",
    "check-types": "tsc --noEmit",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "prisma:db:push": "prisma db push --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:reset": "prisma migrate reset --schema prisma/schema.prisma",
    "test": "node --test index.test.mjs ../../test-support/prisma-test-safety.test.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.9.1",
    "@prisma/client-runtime-utils": "^7.8.0",
    "dotenv": "^17.4.0",
    "pg": "^8.17.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "prisma": "^7.8.0",
    "typescript": "5.9.2"
  },
  "license": "MIT",
  "author": "giovisi"
}
