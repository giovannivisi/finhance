{
  "name": "finhance",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @finhance/db run prisma:generate",
    "db:migrate:deploy": "pnpm --filter @finhance/db run prisma:migrate:deploy",
    "db:migrate:dev": "pnpm --filter @finhance/db run prisma:migrate:dev",
    "db:migrate:reset": "pnpm --filter @finhance/db run prisma:migrate:reset",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^20.19.0 || ^22.12.0"
  }
}
