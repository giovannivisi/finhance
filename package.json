{
  "name": "finhance",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @finhance/db run prisma:generate",
    "db:migrate:deploy": "pnpm --filter @finhance/db run prisma:migrate:deploy",
    "db:migrate:dev": "pnpm --filter @finhance/db run prisma:migrate:dev",
    "db:migrate:reset": "pnpm --filter @finhance/db run prisma:migrate:reset",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.9.0 <23"
  },
  "pnpm": {
    "overrides": {
      "@nestjs/common": "11.1.18",
      "@nestjs/core": "11.1.18",
      "@nestjs/platform-express": "11.1.18",
      "@nestjs/testing": "11.1.18",
      "body-parser@2.2.0": "2.2.2",
      "brace-expansion@1.1.12": "1.1.14",
      "brace-expansion@5.0.5": "5.0.6",
      "defu@6.1.4": "6.1.7",
      "diff": "4.0.4",
      "effect@3.18.4": "3.20.0",
      "fast-uri": "3.1.2",
      "flatted@3.3.3": "3.4.2",
      "handlebars": "4.7.9",
      "js-yaml@4.1.0": "4.1.1",
      "lodash": "4.18.0",
      "minimatch@3.1.2": "3.1.5",
      "multer@2.1.0": "2.1.1",
      "path-to-regexp@8.3.0": "8.4.0",
      "picomatch@2.3.1": "2.3.2",
      "picomatch": "4.0.4",
      "postcss": "8.5.10",
      "qs@6.14.0": "6.15.2",
      "qs@6.15.1": "6.15.2",
      "serialize-javascript": "7.0.5",
      "webpack": "5.104.1",
      "uuid@7.0.3": "11.1.1"
    }
  }
}
